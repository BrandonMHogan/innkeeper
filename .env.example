POSTGRES_DB=innkeeper
POSTGRES_USER=innkeeper
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://innkeeper:changeme@db:5432/innkeeper
SESSION_SECRET=change-this-to-a-random-32-char-string
API_PORT=8000
# Leave PUBLIC_API_URL empty for the standard same-origin Docker Compose setup.
# nginx (frontend container) reverse-proxies /api/ to the api service internally,
# so the browser only ever talks to one origin (the frontend's port) and the
# session cookie (SameSite=Lax) is always sent.
# Only set this to an absolute URL (e.g. http://localhost:8000) if running the
# frontend dev server (`npm run dev`) standalone against a separately-running API.
PUBLIC_API_URL=
